PORT=5679

# Optional. Node 22.21+ can use an HTTP proxy for upstream AI services.
# Keep local services (such as ComfyUI) in NO_PROXY.
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# Optional. SQLite 数据库文件位置（默认仓库根 data/huobao.sqlite3）
# SQLITE_PATH=/path/to/huobao.sqlite3

# Optional. 数据根目录（默认仓库根 data/；桌面版由 Electron 注入 HUOBAO_DATA_DIR）
# HUOBAO_DATA_DIR=/path/to/data
# STORAGE_PATH=/path/to/data/static

# Optional. MySQL → SQLite 启动自动迁移（老用户升级）：显式配置 DATABASE_URL 或
# MYSQL_HOST 且 SQLite 为空库时，启动自动一次性导入全部表（原子事务 + 行数校验 +
# 成功后写 .mysql-imported 标记）。关闭：MYSQL_AUTO_IMPORT=false
# DATABASE_URL=mysql://huobao:huobao@127.0.0.1:3306/huobao_drama

# Optional. Public origin for sending uploaded reference images, audio, video,
# and files by URL to compatible generation APIs.
# PUBLIC_BASE_URL=https://your-domain.com

# Optional. LibTV video in the private script-to-video tab (official CLI 1.2.0).
# LIBTV_CLI_BIN=/path/to/libtv
# LIBTV_CONFIG_DIR=/path/to/private/libtv-state
# Override the canvas prepared by local website authorization with an existing canvas.
# LIBTV_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Optional. Verified Caddy username of the site administrator, who can publish release notes and manage feedback.
# RELEASE_NOTES_ADMIN_USER=owner

# Optional. Additional verified Caddy username allowed to view and handle feedback.
# FEEDBACK_ADMIN_USER=feedback-operator

# Local development only. Put these values in backend/.env.local to enable
# sign-in at http://localhost:3013. Use a local signing secret of at least 32 bytes.
# If using a Caddy account snapshot, set a single JSON value with its bcrypt hashes.
# The feedbackAdministrator field is optional. Keep this snapshot in the private local env file.
# DRAMA_LOCAL_SITE_ACCOUNTS='{"administrator":"owner","feedbackAdministrator":"operator","hashes":{"owner":"<bcrypt hash>","operator":"<bcrypt hash>"}}'
# Without a snapshot, use separate passwords for the admin and member test accounts.
# DRAMA_LOCAL_SITE_ADMIN_PASSWORD=
# DRAMA_LOCAL_SITE_MEMBER_PASSWORD=
# DRAMA_LOCAL_SITE_SESSION_SECRET=

# Optional. 关闭文本模型思考(thinking)模式,默认 true。
# 对 new-api 类中转站在请求体注入关思考参数,规避中转站强制回传
# reasoning_content 导致的 400;官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 可选:自定义注入的 OpenAI 风格参数(JSON),适配不同中转站
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}
