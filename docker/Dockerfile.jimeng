ARG DRAMA_PLUS_BASE_IMAGE=drama-plus:latest
FROM ${DRAMA_PLUS_BASE_IMAGE}

# The CLI uses the system CA bundle for TLS, independently of Node's bundled roots.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates dbus-daemon dbus-bin gnome-keyring libsecret-tools \
  && test -s /etc/ssl/certs/ca-certificates.crt \
  && rm -rf /var/lib/apt/lists/*

# Official Dreamina Canvas CLI 1.4.0, release 1_0_0_62. Hashes come from the release's payload.sha256.
RUN set -eu; \
  architecture="$(dpkg --print-architecture)"; \
  case "$architecture" in \
    amd64) expected=39e4d8fef297f5db2766640c00c6a9567bbfef40b59e52436300490c538c225a ;; \
    arm64) expected=f67d0a8ebfd364cf35dcefff47affa880a7486e28e49410ef4d974a6ecd089c4 ;; \
    *) echo 'Dreamina Canvas CLI requires Linux amd64 or arm64' >&2; exit 1 ;; \
  esac; \
  binary=/usr/local/bin/dreamina-canvas; \
  node --input-type=module -e '\
    import { writeFile } from "node:fs/promises"; \
    const [, architecture, destination] = process.argv; \
    const release = "https://jimeng.jianying.com/canvas-cli/install/1_0_0_62"; \
    const response = await fetch(`${release}/dreamina-canvas_linux_${architecture}`, { signal: AbortSignal.timeout(120_000) }); \
    if (!response.ok) throw new Error(`Official Dreamina CLI download failed: HTTP ${response.status}`); \
    await writeFile(destination, Buffer.from(await response.arrayBuffer())); \
  ' "$architecture" "$binary"; \
  printf '%s  %s\n' "$expected" "$binary" | sha256sum -c -; \
  chmod 0755 "$binary"

ENV JIMENG_CLI_BIN=/usr/local/bin/dreamina-canvas
COPY docker/jimeng-entrypoint.sh /usr/local/bin/drama-plus-jimeng-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/drama-plus-jimeng-entrypoint \
  && chmod 0755 /usr/local/bin/drama-plus-jimeng-entrypoint

VOLUME ["/var/lib/drama-plus/jimeng"]
ENTRYPOINT ["/usr/local/bin/drama-plus-jimeng-entrypoint"]
CMD ["/app/entrypoint.sh"]
